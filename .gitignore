# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Packed tarballs. A build artifact in a repository whose thesis is that views
# are computed and never stored would be a contradiction on the first commit.
*.tgz

# Package manager stores and caches. Lockfiles are tracked; stores are not.
.pnpm-store/
.yarn/
.pnp.*

# Logs and caches
*.log
npm-debug.log*
.npm/
coverage/
.cache/

# Secrets and local environment
.env
.env.*
!.env.example
*.pem

# Working scratch: small follow-ups no Decision or test tracks yet. Never
# part of the record — anything that matures moves into record/ as its own
# artifact and leaves this file.
followup.md

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
._*
