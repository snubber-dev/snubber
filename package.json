{
  "name": "snubber",
  "version": "0.1.0",
  "description": "Keeps settled things settled in a repository worked on with agents.",
  "license": "MIT",
  "author": "FelineFelon (https://github.com/FelineFelon)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snubber-dev/snubber.git"
  },
  "homepage": "https://snubber.dev",
  "bugs": "https://github.com/snubber-dev/snubber/issues",
