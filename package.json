  "scripts": {
    "check": "node src/cli.ts check",
    "board": "node src/cli.ts board",
    "rules": "node src/cli.ts rules",
    "test": "node test/run.ts",
    "prepublishOnly": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.json"
